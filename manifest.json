{
    "manifest_version": 3,
    "name":"Time-Tracker",
    "version":"1.0",
    "description":"A simple time tracker for your Chrome Browser.",
    "permissions":["tabs","storage","idle"],
    "background":{
        "service_worker":"background.js"
    },
    "action":{
        "default_popup":"popup.html",
        "default_icon":{
            "16":"icon.png"
        }
    }
}